        "codeat3/blade-academicons": "^1.8",
        "codeat3/blade-akar-icons": "^2.0",
        "codeat3/blade-ant-design-icons": "^1.9",
        "codeat3/blade-bytesize-icons": "^1.6",
        "codeat3/blade-carbon-icons": "^2.34",
        "codeat3/blade-clarity-icons": "^1.10",
        "codeat3/blade-coolicons": "^1.6",
        "codeat3/blade-cryptocurrency-icons": "^1.8",
        "codeat3/blade-devicons": "^1.8",
        "codeat3/blade-element-plus-icons": "^1.1",
        "codeat3/blade-elusive-icons": "^1.5",
        "codeat3/blade-emblemicons": "^1.5",
        "codeat3/blade-eos-icons": "^1.15",
        "codeat3/blade-evil-icons": "^1.6",
        "codeat3/blade-file-icons": "^1.10",
        "codeat3/blade-fluentui-system-icons": "^1.34",
        "codeat3/blade-fontaudio": "^1.7",
        "codeat3/blade-fontisto-icons": "^1.5",
        "codeat3/blade-forkawesome": "^1.11",
        "codeat3/blade-govicons": "^1.5",
        "codeat3/blade-gravity-ui-icons": "^1.3",
        "codeat3/blade-humbleicons": "^1.1",
        "codeat3/blade-iconpark": "^1.7",
        "codeat3/blade-line-awesome-icons": "^1.5",
        "codeat3/blade-majestic-icons": "^2.2",
        "codeat3/blade-maki-icons": "^1.9",
        "codeat3/blade-microns": "^1.6",
        "codeat3/blade-mono-icons": "^1.5",
        "codeat3/blade-pepicons": "^1.6",
        "codeat3/blade-phosphor-icons": "^2.0",
        "codeat3/blade-pixelarticons": "^1.6",
        "codeat3/blade-prime-icons": "^1.7",
        "codeat3/blade-radix-icons": "^1.8",
        "codeat3/blade-rpg-awesome-icons": "^1.6",
        "codeat3/blade-simple-line-icons": "^1.5",
        "codeat3/blade-solar-icons": "^1.2",
        "codeat3/blade-system-uicons": "^1.8",
        "codeat3/blade-teeny-icons": "^1.11",
        "codeat3/blade-typicons": "^1.7",
        "codeat3/blade-uiw-icons": "^1.6",
        "codeat3/blade-unicons": "^1.9",

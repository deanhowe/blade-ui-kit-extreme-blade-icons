        "hasnayeen/blade-eva-icons": "^2.1",
        "illuminate/contracts": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/view": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "itsmalikjones/blade-iconic": "^1.3",
        "johan-boshoff/blade-car-makes-icons": "^1.0",
        "khatabwedaa/blade-css-icons": "^1.5",
        "log1x/blade-filetype-icons": "^1.0",
        "mallardduck/blade-boxicons": "^2.4",
        "mallardduck/blade-lucide-icons": "^1.23",
        "mckenziearts/blade-untitledui-icons": "^1.4",
        "nerdroid23/blade-icomoon": "^2.0",
        "owenvoke/blade-entypo": "^2.2",
        "owenvoke/blade-fontawesome": "^2.9",
        "postare/blade-mdi": "^1.1",
        "secondnetwork/blade-tabler-icons": "^3.31",
        "smarteknoloji/blade-circle-flags": "^1.0",
        "stijnvanouplines/blade-country-flags": "^1.0",
        "symfony/console": "^5.3|^6.0|^7.0",
        "symfony/finder": "^5.3|^6.0|^7.0",
        "themesberg/flowbite-blade-icons": "dev-main",
        "ublabs/blade-coreui-icons": "^0.4.0",
        "ublabs/blade-simple-icons": "^0.185.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.5.1",
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^9.0|^10.5|^11.0"
    },
    "bin": [
        "bin/blade-icons-generate"
    ],
    "autoload": {
        "psr-4": {
            "DeanHowe\\BladeUIKitExtremeBladeIcons\\Icons\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BladeUI\\Icons\\BladeIconsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
       "flowbite-blade-icons": {
            "type": "vcs",
            "url": "https://github.com/deanhowe/flowbite-blade-icons"
        },
        "blade-lineicons": {
            "type": "vcs",
            "url": "https://github.com/deanhowe/blade-lineicons"
        },
        "blade-tabler-icons": {
            "type": "vcs",
            "url": "https://github.com/deanhowe/blade-tabler-icons"
        }
    }
}

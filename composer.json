{
    "name": "deanhowe/blade-ui-kit-extreme-blade-icons",
    "description": "A package to easily make use of an EXTREME amount of icons in your Laravel Blade views.",
    "keywords": ["Blade", "Icons", "Laravel", "SVG"],
    "homepage": "https://github.com/deanhowe/blade-ui-kit-extreme-blade-icons",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/deanhowe/blade-ui-kit-extreme-blade-icons/issues",
        "source": "https://github.com/deanhowe/blade-ui-kit-extreme-blade-icons/blade-icons"
    },
    "authors": [
        {
            "name": "Dean Howe",
            "homepage": "https://deanhowe.co.uk"
        },
        {
            "name": "Dries Vints",
            "homepage": "https://driesvints.com"
        }
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/deanhowe"
        },
        {
            "type": "paypal",
            "url": "https://www.paypal.com/paypalme/de@n-howe.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "afatmustafa/blade-hugeicons": "^1.0",
